# KALINGA local configuration. Copy to .env (gitignored). Safe DEMO defaults only.
NODE_ENV=development
PORT=3001
DEMO_MODE=true
CLINICAL_CONTENT_APPROVED=false
ALLOW_REAL_BOOKING_REQUESTS=false
REAL_MINOR_BOOKING_ENABLED=false
NOTIFICATION_TRANSPORT=mock
REAL_NOTIFICATIONS_ENABLED=false
# Local PGlite data directory (gitignored); leave empty for in-memory.
PGLITE_DATA_DIR=
