# KALINGA local configuration. Copy to .env (gitignored). Safe DEMO defaults only.
NODE_ENV=development
PORT=3001
DEMO_MODE=true
CLINICAL_CONTENT_APPROVED=false
# Required only if CLINICAL_CONTENT_APPROVED=true (never allowed with DEMO_MODE=true): reference to the approval evidence.
CLINICAL_CONTENT_EVIDENCE_REF=
ALLOW_REAL_BOOKING_REQUESTS=false
REAL_MINOR_BOOKING_ENABLED=false
NOTIFICATION_TRANSPORT=mock
REAL_NOTIFICATIONS_ENABLED=false
# Local PGlite data directory (gitignored); leave empty for in-memory.
PGLITE_DATA_DIR=
# HMAC key for booking secret verifiers (>= 32 chars). Leave empty in DEMO_MODE (a fixed DEMO key is used); required otherwise.
BOOKING_SECRET_KEY=
# Interface to bind. Default: 127.0.0.1 when DEMO_MODE=true (demo data never leaves the machine), 0.0.0.0 otherwise.
HOST=
# Reverse-proxy hops to trust for client IP (rate limiters). 0 = none (default).
TRUST_PROXY_HOPS=0
