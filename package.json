{
  "name": "kalinga",
  "private": true,
  "version": "0.0.0",
  "description": "KALINGA local prototype (DEMO only)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "concurrently -k -n api,web \"npm run dev -w @kalinga/api\" \"npm run dev -w @kalinga/web\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
